	"51505": {
		"ability": "Lava Burst",
		"assumptions": [
			"The 2 sec cast time is a guess, taken from the later-expansion spell of the same name.",
			"The 8 sec cooldown is a guess, taken from the later-expansion spell of the same name.",
			"The 10% of base mana cost is a guess, taken from the later-expansion spell of the same name.",
			"The 0.5714 spell power coefficient is a guess, taken from the later-expansion spell of the same name.",
			"Call of Flame is assumed to raise Lava Burst by 5% per point, as the Forever tooltip names Lava Burst but gives no figure."
		],
		"file": "sim/shaman/lava_burst.go",
		"note": "A new Forever Elemental talent spell; 51505 is the later-expansion Lava Burst id, which the Classic database has no row for, so the site shows no name and no tooltip. Only the damage range and the Flame Shock bonus were on the demo tooltip.",
		"source": "assumed",
		"tooltip": "10% of base mana\n2 sec cast\n8 sec cooldown\nYou hurl molten lava at the target, dealing 158 to 187 Fire damage. If your Flame Shock is on the target, Lava Burst deals 20% increased damage."
	},
	"51521": {
		"ability": "Improved Stormstrike",
		"assumptions": [
			"Rank 2 doubles the 50% proc chance to 100%; only rank 1 was on the demo tooltip.",
			"Rank 2 doubles the 50% dodge/parry reset chance to 100%.",
			"Rank 2 doubles the 50% while-casting mana regeneration to 100%.",
			"The 15 sec buff duration is assumed to be the same at both ranks.",
			"The proc is rolled when the Stormstrike cast completes rather than when it lands; confirm a dodged or parried Stormstrike still procs it."
		],
		"file": "sim/shaman/talents.go",
		"note": "A new Forever Enhancement talent; 51521 is the later-expansion Improved Stormstrike id and the Classic database has no row for it, so nothing renders. The sim tags the buff with rank 1's id (51521) even at rank 2, whose own id is 51522.",
		"source": "assumed",
		"tooltip": "15 sec duration\nWhen you Stormstrike, you have a 50% chance to gain 50% mana regeneration while casting spells for 15 sec, and Stormstrike's cooldown has a 50% chance to reset each time you Dodge or Parry."
	},
	"51530": {
		"ability": "Maelstrom Weapon",
		"assumptions": [
			"The proc rate is 2 procs per minute per talent point (10 PPM at 5/5); no proc rate was ever published.",
			"Ranks 2 to 5 scale the 4% per stack linearly to 8%, 12%, 16% and 20%, so 5/5 at 5 stacks is a free instant Lightning Bolt; only rank 1 was on the demo tooltip.",
			"The stack is spent only by Lightning Bolt (Chain Lightning is not reduced), and the whole stack is consumed by one cast."
		],
		"file": "sim/shaman/talents.go",
		"note": "A new Forever Enhancement talent; 51530 is the later-expansion Maelstrom Weapon id and the Classic database has no row for it, so nothing renders. The talent has five ranks (51528-51532) but the sim tags the stacking buff with 51530 at every rank.",
		"source": "assumed",
		"tooltip": "30 sec duration\nWhen you deal damage with a melee attack, you have a chance to reduce the cast time and Mana cost of your next Lightning Bolt spell by 4%. Stacks up to 5 times."
	},
	"52127": {
		"ability": "Water Shield",
		"assumptions": [
			"The 6% of base mana cost is a guess; the demo tooltip showed no cost.",
			"The 3.5 sec between globes is a guess: the tooltip only said \"only one globe will activate every few seconds\", so Lightning Shield's internal cooldown was borrowed."
		],
		"file": "sim/shaman/water_shield.go",
		"note": "A new Forever Restoration talent spell; 52127 is the later-expansion Water Shield id and the Classic database has no row for it, so the site shows no name and no tooltip. The 3 globes, the 2% of maximum mana and the 10 min duration are the published figures.",
		"source": "assumed",
		"tooltip": "6% of base mana\nInstant\nThe caster is surrounded by 3 globes of water. When a spell, melee, or ranged attack hits the caster or when one of the caster's healing spells gets a critical result, 2% of maximum mana is restored to the caster, expending one water globe. Only one globe will activate every 3.5 sec. Lasts 10 min. Only one Elemental Shield can be active on the Shaman at any one time."
	},
