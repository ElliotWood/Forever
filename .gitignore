# Per-client extraction settings, kept local. The default and ptr- ones are
# tracked; era-, sod- and forever- are scratch for other client builds.
tools/database/era-generator-settings.json
tools/database/sod-generator-settings.json
tools/database/forever-generator-settings.json

# Client-extracted databases and caches. Output of `make db` from a local WoW
# install, tens of MB each, and rebuildable - the same reason wowsims.db is here.
tools/database/*.db
tools/db2tool/DBDCache.bak/
tools/db2tool/dbfilesclient-era-new/

# The spellbook page builder and the Forever description tool. Both produce
# published artifacts rather than anything the sim reads, so they stay local.
tools/spellbook/
tools/foreverdesc/
__pycache__/
